#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
/bin/busybox --install -s /bin
export LOCPATH=/lib/locale
mkdir -p /proc /sys /dev /tmp
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs -o size=32m tmpfs /tmp
echo LIBC_SYSTEM_BEGIN
uname -a
cat /sys/devices/system/clocksource/clocksource0/current_clocksource
failed=0
for variant in glibc-time32 glibc-time64 musl-shared musl-static; do
    echo "LIBC_VARIANT_BEGIN $variant"
    /tests/"$variant"
    status=$?
    echo "LIBC_VARIANT_END $variant $status"
    [ "$status" -eq 0 ] || failed=1
done
echo "LIBC_GATE_DONE $failed"
# Host collects the markers and terminates QEMU. No persistent media attached.
while :; do sleep 3600; done
